  "primary_task": {
    "actor_ref": "office_coordinator",
    "objective": "Open one incoming estimate request, complete its minimum facts, and record the accountable next step without losing its source or requester-visible history.",
    "success_signal": "The request spine shows a retained source, complete minimum details, a current state, one accountable person, and one permission-valid next move backed by an executable command ref."
  },
  "rejection_checks": [
    "primary evidence or decision object is present in the first viewport",
    "route heading changes do not reuse an incompatible entity collection",
    "every mutation has a command or declared adapter binding",
    "permission denial is enforced by the server and explained by the client",
    "reload preserves the durable identifier and completed decision",
    "generic fallback workspace is absent from the completed experience",
    "only one focused mode exposes its tools at a time",
    "advanced controls are hidden by default behind the declared disclosure",
    "the primary object remains available on desktop and mobile",
    "each mode exposes no more than one primary action"
  ],
  "required_panel_markers": [
    "data-experience-panel=\"request_spine_panel\"",
